// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(255)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  firstName          String               @map("first_name") @db.VarChar(100)
  lastName           String               @map("last_name") @db.VarChar(100)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  refreshSessions    RefreshSession[]
  memberships        OrganizationMember[]
  reportedIncidents  Incident[]           @relation("IncidentReporter")
  incidentComments   IncidentComment[]
  incidentActivities IncidentActivity[]

  @@map("users")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(64)
  // Last incident number handed out; incremented in the create transaction.
  incidentCounter Int      @default(0) @map("incident_counter")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  members   OrganizationMember[]
  teams     Team[]
  projects  Project[]
  incidents Incident[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberships   TeamMember[]
  assignedIncidents Incident[]   @relation("IncidentAssignee")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  assignedIncidents Incident[]

  @@unique([organizationId, name])
  @@map("teams")
}

// Points at the organization membership, so leaving the organization also
// removes the person from its teams.
model TeamMember {
  id                   String   @id @default(uuid()) @db.Uuid
  teamId               String   @map("team_id") @db.Uuid
  organizationMemberId String   @map("organization_member_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@index([organizationMemberId])
  @@map("team_members")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// Archived projects keep their data; names stay unique including archived
// ones, so restoring a project never clashes with a newer one.
model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.VarChar(2000)
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents    Incident[]

  @@unique([organizationId, name])
  @@map("projects")
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  BLOCKED
  RESOLVED
  CLOSED
}

// Declared from least to most urgent, so sorting by priority descending
// puts CRITICAL first.
enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentActivityType {
  CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  TEAM_CHANGED
  PROJECT_CHANGED
  COMMENT_ADDED
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  // Per-organization number shown as INC-<number>.
  number         Int
  title          String           @db.VarChar(200)
  description    String?          @db.VarChar(10000)
  status         IncidentStatus   @default(OPEN)
  priority       IncidentPriority @default(MEDIUM)
  projectId      String?          @map("project_id") @db.Uuid
  reporterId     String?          @map("reporter_id") @db.Uuid
  // The assignee's organization membership: leaving the organization
  // unassigns them.
  assigneeId     String?          @map("assignee_member_id") @db.Uuid
  assignedTeamId String?          @map("assigned_team_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  resolvedAt     DateTime?        @map("resolved_at")
  closedAt       DateTime?        @map("closed_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NoAction: a project with incidents cannot be deleted (only archived),
  // while deleting the whole organization still cascades.
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: NoAction)
  reporter     User?               @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee     OrganizationMember? @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedTeam Team?               @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  comments     IncidentComment[]
  activities   IncidentActivity[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, updatedAt])
  @@index([projectId])
  @@index([assigneeId])
  @@index([assignedTeamId])
  @@map("incidents")
}

model IncidentComment {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  content    String   @db.VarChar(5000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_comments")
}

// Values are stored as display text (e.g. names), so the history stays
// readable after people, teams or projects change.
model IncidentActivity {
  id         String               @id @default(uuid()) @db.Uuid
  incidentId String               @map("incident_id") @db.Uuid
  actorId    String?              @map("actor_id") @db.Uuid
  type       IncidentActivityType
  oldValue   String?              @map("old_value") @db.VarChar(255)
  newValue   String?              @map("new_value") @db.VarChar(255)
  createdAt  DateTime             @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_activities")
}
